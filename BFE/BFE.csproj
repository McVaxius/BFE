<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <Version>1.0.0.4</Version>
    <FileVersion>1.0.0.4</FileVersion>
    <AssemblyVersion>1.0.0.4</AssemblyVersion>
    <NoWarn>CS0219;CS0414;CS0618;CS0649;CS8632</NoWarn>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <RootNamespace>BFE</RootNamespace>
    <AssemblyName>BFE</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ECommons" Version="3.1.0.1" PrivateAssets="none" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\aethertekUI\src\AethertekUI\AethertekUI.csproj" />
    <ProjectReference Include="..\..\aethertekUI\src\AethertekUI.Dalamud\AethertekUI.Dalamud.csproj" />
    <EmbeddedResource Update="Localization\Strings_*.resx" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="BFE.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="images\icon.png" LogicalName="BFE.images.icon.png" />
    <None Include="Resources\Images\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
