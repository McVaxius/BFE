<Project Sdk="Dalamud.NET.Sdk/14.0.2">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <Version>0.1.0.12</Version>
    <FileVersion>0.1.0.12</FileVersion>
    <AssemblyVersion>0.1.0.12</AssemblyVersion>
    <NoWarn>CS0219;CS0414;CS0618;CS0649;CS8632</NoWarn>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <RootNamespace>BFE</RootNamespace>
    <AssemblyName>BFE</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ECommons" Version="3.1.0.1" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <None Include="BFE.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\Images\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
